./: {*/ -build/}

# Silence harmless warnings triggered by the upstream tests and headers.
#
if ($c.target.system == 'win32-msvc')
  c.poptions += -D_CRT_SECURE_NO_WARNINGS -D_CRT_NONSTDC_NO_DEPRECATE

if ($c.class == 'gcc')
  c.coptions += -Wno-implicit-fallthrough -Wno-type-limits \
                -Wno-unused-function -Wno-unused-parameter \
                -Wno-strict-prototypes
elif ($c.class == 'msvc')
  c.coptions += /wd4100 /wd4244 /wd4267 /wd4701 /wd4703
